# Frontend (React CRA) — salin ke .env
REACT_APP_SANITY_PROJECT_ID=yourProjectId
REACT_APP_SANITY_DATASET=production

# Studio (folder studio/) — salin juga ke studio/.env
SANITY_STUDIO_PROJECT_ID=yourProjectId
SANITY_STUDIO_DATASET=production

# Hanya untuk seed lokal (JANGAN commit / JANGAN taruh di Vercel public)
SANITY_PROJECT_ID=yourProjectId
SANITY_DATASET=production
SANITY_API_TOKEN=
